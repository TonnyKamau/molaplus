# Run node scripts/setup-studio.mjs to set credentials in .env.local.
STUDIO_EMAIL=admin@molaplusafrica.com
STUDIO_PASSWORD_HASH=
# Match the externally accessible origin; omit for local development.
# STUDIO_ORIGIN=https://molaplusafrica.com
# Absolute path to a durable, writable directory on a persistent Node server.
# STUDIO_DATA_DIR=/var/lib/molaplus

# SMS order notifications (all three required).
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
MOLAPLUS_ORDER_SMS_TO=
# AFRICASTALKING_SENDER_ID=
